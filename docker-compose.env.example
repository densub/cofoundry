# Copy to project root as `.env` for docker compose variable substitution:
#   cp docker-compose.env.example .env
#
# Backend secrets: still use backend/.env (loaded by the backend service).
# These two are required to build the frontend image (Vite embeds them at build time).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URLs for OAuth redirects when using Docker locally
FRONTEND_URL=http://localhost:8080
APP_URL=http://localhost:3001

# Optional port overrides
# FRONTEND_PORT=8080
# BACKEND_PORT=3001
