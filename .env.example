# TEST = local dev, PROD = production / GCP
SUPABASE_ENV=TEST

# Supabase (production)
SUPABASE_URL_PROD=https://your-project.supabase.co
SUPABASE_ANON_KEY_PROD=your-anon-key
SUPABASE_SERVICE_ROLE_KEY_PROD=your-service-role-key
# Supabase (test — leave empty until you have a test project)
SUPABASE_URL_TEST=
SUPABASE_ANON_KEY_TEST=
SUPABASE_SERVICE_ROLE_KEY_TEST=
# Database (for `npm run db:migrate`) — Session pooler URI from Supabase → Database → Connection string
SUPABASE_DATABASE_URL_PROD=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL_TEST=
# Legacy fallback if URL is not set (not recommended)
SUPABASE_DB_PROD_PASSWORD=your-database-password
SUPABASE_DB_TEST_PASSWORD=

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for embeddings — required for user matching)
OPENAI_API_KEY=sk-...

# SendGrid (for external GitHub invites)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=invites@example.com

# Node chat AI limits (per user, rolling 24 hours; exact cache hits are free)
AI_CHAT_DAILY_LIMIT=2
AI_CHAT_INPUT_TOKEN_LIMIT=6000
AI_CHAT_OUTPUT_TOKEN_LIMIT=700
AI_CHAT_CACHE_TTL_DAYS=7

# Backend
PORT=3001
FRONTEND_URL=http://localhost:5173
