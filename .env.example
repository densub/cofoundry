# TEST = local dev, PROD = production / GCP
SUPABASE_ENV=TEST

# Supabase (production)
SUPABASE_URL_PROD=https://your-project.supabase.co
SUPABASE_ANON_KEY_PROD=your-anon-key
SUPABASE_SERVICE_ROLE_KEY_PROD=your-service-role-key
# Supabase (test — leave empty until you have a test project)
SUPABASE_URL_TEST=
SUPABASE_ANON_KEY_TEST=
SUPABASE_SERVICE_ROLE_KEY_TEST=
# Database password (for running supabase/migrations via `node migrate.js`)
SUPABASE_DB_PROD_PASSWORD=your-database-password
SUPABASE_DB_TEST_PASSWORD=

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for embeddings — required for user matching)
OPENAI_API_KEY=sk-...

# SendGrid (for external GitHub invites)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=invites@example.com

# Backend
PORT=3001
FRONTEND_URL=http://localhost:5173
