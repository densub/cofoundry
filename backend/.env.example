# TEST = local dev, PROD = production / GCP
SUPABASE_ENV=TEST
SUPABASE_URL_PROD=https://your-project.supabase.co
SUPABASE_ANON_KEY_PROD=your-anon-key
SUPABASE_SERVICE_ROLE_KEY_PROD=your-service-role-key
SUPABASE_URL_TEST=https://your-test-project.supabase.co
SUPABASE_ANON_KEY_TEST=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY_TEST=your-test-service-role-key
# Database password (for running supabase/migrations via `node migrate.js`)
SUPABASE_DB_PROD_PASSWORD=your-prod-database-password
SUPABASE_DB_TEST_PASSWORD=your-test-database-password
