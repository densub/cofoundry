SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-database-password
ANTHROPIC_API_KEY=sk-ant-...
# Leave empty to disable embeddings; set a real key for user matching
OPENAI_API_KEY=
PORT=3001
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3001

# GitHub OAuth — https://github.com/settings/developers → New OAuth App
# Callback: http://localhost:3001/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth — https://www.linkedin.com/developers/apps
# Product: Sign In with LinkedIn using OpenID Connect
# Callback: http://localhost:3001/api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
